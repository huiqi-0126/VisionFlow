# ════════════════════════════════════════════════════════════════
# cloneVideo - 室内装修视频复刻 配置
# 复制本文件为 .env 并填入真实值（与 VisionFlow 共用同一套凭据即可）
# ════════════════════════════════════════════════════════════════

# --- 多模态 LLM (OpenAI 兼容) ---
# 用于关键帧画面分析 + 风格画像提取 + 镜头 prompt 生成
qwen_api_key=
qwen_baseurl=
qwen_model=qwen-plus
AL_API_KEY=
AL_BASE_URL=
AL_MODEL=glm-5v-turbo

# --- 火山云 TOS 对象存储 ---
# gkapi 生成接口需要公网可访问的图片 URL，本地文件必须先上传到 TOS
SECRETID=
SECRETKEY=
REGION=
BUCKET=
COC_URL=

# --- 媒体生成 API (gkapi 聚合接口) ---
# 图像模型 gemini-3.0 (Nano Banana Pro，参考图风格保持)
# 视频模型 seedance-2.0-fast (单图→4s 视频，支持运镜 prompt)
gkapi_baseurl=
gkapi_key=

# --- 生成默认参数 (尺寸跟随源视频，aspectRatio 在运行时动态覆盖) ---
MODEL=seedance-2.0-fast
IMAGE_MODEL=gemini-3.0

# --- 视频分析参数 ---
FFMPEG_PATH=ffmpeg

# --- 轮询参数 ---
# poll_interval=5
# max_poll_attempts=120
